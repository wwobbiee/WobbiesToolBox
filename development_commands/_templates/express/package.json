{
  "name": "express-app",
  "version": "1.0.0",
  "author": "",
  "description": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch",
    "watch:dev": "nodemon --ignore public/ server.js",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:dev\""
  },
  "dependencies": {
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "connect-livereload": "^0.6.1",
    "concurrently": "^9.2.4",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.14"
  }
}
